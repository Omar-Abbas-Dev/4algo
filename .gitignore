.vs/
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets / local machine config
appsettings.Local.json
appsettings.Development.json
*.pfx
*.key

# Docker local overrides
docker-compose.override.yml
